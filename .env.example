APP_NAME="RadiantDx"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Production deployment (pulsecore.med.et). The Plesk vhost has its document
# root at httpdocs, so Laravel's public/ is what gets published there and the
# rest of the application stays above it, outside the web root. The preferred
# domain is the apex, so www is 301'd to it — APP_URL must be the apex too or
# every signed URL and asset redirects once before it resolves.
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://pulsecore.med.et
#   SESSION_SECURE_COOKIE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=harme_laboratory
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@pulsecore.med.et"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Laboratory / organisation identity used on printed reports
# ---------------------------------------------------------------------------
LAB_ORGANISATION_NAME="RadiantDx"
LAB_DEPARTMENT_NAME="Department of Laboratory Medicine"
LAB_ADDRESS_LINE="Harer, Ethiopia"
LAB_CONTACT_PHONE=""
LAB_CONTACT_EMAIL=""
LAB_LICENCE_NUMBER=""
LAB_REPORT_FOOTER="Results relate only to the specimen received. This report is not valid without laboratory validation."
# Letterhead mark: a path inside public/, an http(s) or data: URI, or empty for
# a text-only letterhead. Use a compact mark — a wordmark in the artwork is
# unreadable at the size the letterhead renders it.
LAB_LOGO_PATH="images/logo-mark.svg"
# The dark-background variant, used by the application footer. Empty
# falls back to the mark above.
LAB_LOGO_INVERSE_PATH="images/logo-mark-inverse.svg"

# ---------------------------------------------------------------------------
# Application footer
# ---------------------------------------------------------------------------
# Every value here is optional: an empty one is left out of the footer rather
# than rendered blank, and a policy link is never printed pointing at a page
# that does not exist.
LAB_VERSION="2.4.0"
LAB_SUPPORT_HOTLINE=""
LAB_SUPPORT_EMAIL=""
# Comma separated, e.g. "ISO 15189 Accredited, HIPAA Compliant". Asserted by
# the deployment, never assumed by the software.
LAB_ACCREDITATIONS=""
LAB_PRIVACY_URL=""
LAB_TERMS_URL=""
LAB_DATA_PROTECTION_URL=""

# ---------------------------------------------------------------------------
# Initial Super Admin. Set a strong password before running `php artisan db:seed`.
# Never commit a real production password to version control.
# ---------------------------------------------------------------------------
SUPER_ADMIN_NAME="System Administrator"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

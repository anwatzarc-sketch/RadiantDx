* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Vendored code and build output ship byte-for-byte on this branch. The
# repo-wide "* text=auto eol=lf" above must not rewrite them.
vendor/**        -text
public/build/**  -text
